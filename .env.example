# The application binds locally. The default payments mode is simulated.
PORT=4326
HOST=127.0.0.1
# RAINCHECK_DATA_DIR=/absolute/path/to/private/runtime

# Optional real sandbox payments. Open /sandbox.html to create and capture a test booking.
# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=
# RAINCHECK_BASE_URL=http://127.0.0.1:4326
# Advanced: RAINCHECK_SCENARIO_FILE=/absolute/path/to/private/scenario.json

# Optional live structured AI. Requests require both private credit budgets below.
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_BUDGET_FILE=/absolute/path/to/private/budget.json
# NEBIUS_BUDGET_RUNTIME_DIR=/absolute/path/to/private/runtime
# RAINCHECK_BUDGET_FILE=/absolute/path/to/private/raincheck-cap.json
# RAINCHECK_MODEL_LOG_DIR=/absolute/path/to/optional/private/model-receipts

# Optional AG Studio local batch preflight. Install ag-studio@3.0.0 separately.
# RAINCHECK_STUDIO_BUNDLE=/absolute/path/to/ag-studio/dist/umd/ag-studio.min.js
# RAINCHECK_STUDIO_LICENSE_FILE=/absolute/path/to/private/studio-license-key.txt
# RAINCHECK_STUDIO_AI=1
